# ── Site connection ──────────────────────────────────────────
SITE_URL=https://your-indexer-site.com
AGENT_TOKEN=your-agent-token-here
POLL_INTERVAL=30

# ── VPN ─────────────────────────────────────────────────────
# Provider list: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_PROVIDER=torguard
VPN_TYPE=openvpn
VPN_USER=your-vpn-username
VPN_PASS=your-vpn-password
VPN_COUNTRY=Netherlands

# Split-tunnel mode: only route torrent downloads through VPN,
# NNTP uploads go direct for full upload speed.
# Set VPN_DOWNLOAD_ONLY=true and AGENT_NETWORK_MODE=bridge to enable.
VPN_DOWNLOAD_ONLY=false
# AGENT_NETWORK_MODE=bridge        # uncomment to disable full-tunnel VPN
# VPN_PROXY_ADDR=vpn:1080          # gluetun SOCKS5 proxy (default)

# ── Usenet upload (NNTP) ────────────────────────────────────
NNTP_SERVER=news.your-provider.com:563
NNTP_SSL=true
NNTP_CONNECTIONS=10
NNTP_USER=your-usenet-username
NNTP_PASS=your-usenet-password
NNTP_GROUP=alt.binaries.test
NNTP_POSTER=agent <agent@your-domain.com>
NNTP_FROM=agent@your-domain.com
NNTP_DOMAIN=your-domain.com

# ── Branding ────────────────────────────────────────────────
# GENERATOR_NAME=loon-agent    # NZB x-generator header and XML comment

# ── Storage ─────────────────────────────────────────────────
# Where downloads, staging, par2 and output live (mounted at /data).
# Unset = a named Docker volume, which lands on Docker's data-root — usually
# the OS disk. Point this at your storage array for real use: a single remux
# can stage tens of GB, and filling the root filesystem takes the host down,
# not just the job. MAX_DISK_USAGE_GB will NOT protect you — the agent uses
# the lesser of that budget and actual free space, so a cap bigger than the
# disk does nothing.
# AGENT_DATA_DIR=/storage/amenzb-agent

# ── Processing ──────────────────────────────────────────────
MAX_CONCURRENT_DOWNLOADS=3
OBFUSCATE=false
ENCRYPT=false
PAR2_REDUNDANCY=5
# PAR2_THREADS=0                   # 0 = all cores
# PAR2_MEMORY_MB=0                 # 0 = auto
# PAR2_METHOD=                     # parpar GF16 kernel; empty = probe for the
#                                  # fastest one that runs on this CPU. Set only
#                                  # to override, e.g. shuffle-avx2
# MAX_DISK_USAGE_GB=0              # 0 = no limit
# CPU_MAX_PERCENT=85               # pause new tasks above this CPU %
# SLOW_SPEED_THRESHOLD_MBS=0.05    # reject downloads slower than this (MB/s)
# SLOW_SPEED_TIMEOUT_MINS=10       # minutes before rejection

# ── Local config UI ─────────────────────────────────────────
# Small browser UI for editing config.yml + per-tracker passkeys without
# SSH'ing in. Published to 127.0.0.1 on the host by docker-compose — reach
# it from the agent host at http://localhost:4869/.
# (4869 = APTX4869, the poison in Detective Conan.)
LOCAL_UI_PORT=4869

# ── Offline uploads ─────────────────────────────────────────
# Groups + watch folders are managed in the local UI at /groups and
# /watches. Drop a .torrent or completed file into a watched folder and
# the agent builds an NZB locally under OFFLINE_OUTPUT_DIR.
# Default path lands next to TempDir (/data/offline-output inside the
# agent container). Override if you want the NZBs written somewhere else.
# OFFLINE_OUTPUT_DIR=/data/offline-output

# ── Inventory reporting (offer staging) ─────────────────────
# Ships the library TREE to the site so you can browse it at
# /account-settings/offers/inventory and pick what to offer. Reporting
# publishes NOTHING — only a selection made on the site becomes an offer.
#
# Independent of OFFER_ENABLED: you can browse what you have without
# listing any of it. Off by default because it discloses every filename
# on the roots below to the site.
# INVENTORY_ENABLED=true
#
# Directories to walk, comma-separated. Leave unset to reuse the folder
# sources already declared in offer.json rather than saying it twice.
# INVENTORY_ROOTS=/media/anime,/media/movies
#
# How often to re-report. A library changes slowly and each walk costs the
# site a title lookup per file, so this is deliberately not frequent.
# INVENTORY_INTERVAL_MIN=360
#
# Noise floor in MB. A media library is mostly sidecars by file count
# (.srt, artwork, sample stubs) and shipping them buries the episodes.
# 0 reports every file.
# INVENTORY_MIN_MB=1
#
# Safety ceiling for one walk. Hitting it leaves the generation OPEN, so
# nothing is pruned on the basis of a walk that did not finish — a
# mis-pointed root cannot wipe your inventory.
# INVENTORY_MAX_FILES=200000
#
# ── Describing what you offer ────────────────────────────
# Runs ffprobe over the files you have staged so an offer gets a detail page
# with codec, duration, audio tracks and subtitle languages — the same
# description a release page shows, for bytes nobody uploaded. Metadata only:
# screenshots for a whole library run to hundreds of GB and cost a video
# decode each, so those are generated when you PUBLISH a file instead.
#
# On by default when INVENTORY_ENABLED is set — reporting a file the site
# cannot describe is most of the work for half the value.
# INVENTORY_PROBE_ENABLED=true
#
# Small and frequent on purpose. A large library is days of work, and an agent
# that spends every cycle probing is not doing the job it was installed for.
# INVENTORY_PROBE_INTERVAL_MIN=15
# INVENTORY_PROBE_BATCH=25
